{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "plugins/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "plugins/**/lib/**",
    "plugins/prompt-to-app/template/**"
  ]
}
