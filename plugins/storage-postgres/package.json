{
  "name": "@dz23-studio/storage-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "dz23-build": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./operator": {
      "dz23-build": { "types": "./lib/operator.d.ts", "default": "./lib/operator.js" },
      "types": "./src/operator.ts",
      "default": "./lib/operator.js"
    }
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-storage-sqlite": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@dz23-studio/runtime-governor": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
