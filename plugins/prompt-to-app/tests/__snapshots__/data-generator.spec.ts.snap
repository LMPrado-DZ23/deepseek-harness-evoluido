// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`deterministic generated data layer > renders reviewable SQL, Zod schemas, repositories and a real CRUD test 1`] = `
{
  "src/db/migrations.ts": "import type { DatabaseSync } from 'node:sqlite'

export const migrations = [
  { version: 1, sql: "CREATE TABLE IF NOT EXISTS \\"entity_cliente\\" (\\n  \\"id\\" TEXT PRIMARY KEY,\\n  \\"nome_completo\\" TEXT NOT NULL,\\n  \\"apelido\\" TEXT,\\n  \\"e_mail\\" TEXT NOT NULL,\\n  \\"telefone\\" TEXT NOT NULL,\\n  \\"nascimento\\" TEXT NOT NULL,\\n  \\"ativo\\" INTEGER NOT NULL CHECK (\\"ativo\\" IN (0, 1)),\\n  \\"limite\\" REAL NOT NULL,\\n  \\"situacao\\" TEXT NOT NULL CHECK (\\"situacao\\" IN ('novo', 'cliente d''ouro')),\\n  \\"created_at\\" TEXT NOT NULL,\\n  \\"updated_at\\" TEXT NOT NULL\\n) STRICT;\\n\\nCREATE TABLE IF NOT EXISTS \\"entity_pedido\\" (\\n  \\"id\\" TEXT PRIMARY KEY,\\n  \\"descricao\\" TEXT NOT NULL,\\n  \\"cliente\\" TEXT NOT NULL REFERENCES \\"entity_cliente\\" (\\"id\\") ON UPDATE CASCADE ON DELETE RESTRICT,\\n  \\"created_at\\" TEXT NOT NULL,\\n  \\"updated_at\\" TEXT NOT NULL\\n) STRICT;" },
] as const

export function migrate(database: DatabaseSync): void {
  database.exec('PRAGMA foreign_keys = ON')
  database.exec('PRAGMA journal_mode = WAL')
  const current = Number(database.prepare('PRAGMA user_version').get()?.user_version ?? 0)
  for (const migration of migrations) {
    if (migration.version <= current) continue
    database.exec('BEGIN IMMEDIATE')
    try {
      database.exec(migration.sql)
      database.exec(\`PRAGMA user_version = \${migration.version}\`)
      database.exec('COMMIT')
    } catch (error) {
      database.exec('ROLLBACK')
      throw error
    }
  }
}
",
  "src/db/schema.ts": "import { z } from 'zod'

export const ClienteInputSchema = z.object({
  "nome_completo": z.string().min(1).max(2_000),
  "apelido": z.string().min(1).max(2_000).optional(),
  "e_mail": z.string().email().max(254),
  "telefone": z.string().min(1).max(2_000),
  "nascimento": z.iso.date(),
  "ativo": z.boolean(),
  "limite": z.number().finite(),
  "situacao": z.enum(["novo","cliente d'ouro"]),
}).strict()
export const ClienteUpdateSchema = ClienteInputSchema.partial().refine(value => Object.keys(value).length > 0, 'Informe ao menos um campo para atualizar.')
export const ClienteRecordSchema = z.object({
  id: z.string().uuid(),
  "nome_completo": z.string().min(1).max(2_000),
  "apelido": z.string().min(1).max(2_000).nullable(),
  "e_mail": z.string().email().max(254),
  "telefone": z.string().min(1).max(2_000),
  "nascimento": z.iso.date(),
  "ativo": z.boolean(),
  "limite": z.number().finite(),
  "situacao": z.enum(["novo","cliente d'ouro"]),
  created_at: z.string().datetime(),
  updated_at: z.string().datetime(),
}).strict()
export type ClienteInput = z.infer<typeof ClienteInputSchema>
export type ClienteUpdate = z.infer<typeof ClienteUpdateSchema>
export type ClienteRecord = z.infer<typeof ClienteRecordSchema>

export const PedidoInputSchema = z.object({
  "descricao": z.string().min(1).max(2_000),
  "cliente": z.string().min(1).max(2_000),
}).strict()
export const PedidoUpdateSchema = PedidoInputSchema.partial().refine(value => Object.keys(value).length > 0, 'Informe ao menos um campo para atualizar.')
export const PedidoRecordSchema = z.object({
  id: z.string().uuid(),
  "descricao": z.string().min(1).max(2_000),
  "cliente": z.string().min(1).max(2_000),
  created_at: z.string().datetime(),
  updated_at: z.string().datetime(),
}).strict()
export type PedidoInput = z.infer<typeof PedidoInputSchema>
export type PedidoUpdate = z.infer<typeof PedidoUpdateSchema>
export type PedidoRecord = z.infer<typeof PedidoRecordSchema>

export const entitySecurity = {
  "cliente": { table: "entity_cliente", sensitive: true, requires_login: true, public_list: false },
  "pedido": { table: "entity_pedido", sensitive: true, requires_login: true, public_list: false },
} as const
",
}
