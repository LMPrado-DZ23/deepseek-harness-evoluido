{
  "name": "@dz23-studio/prompt-to-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "dz23-build": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib", "i18n", "template"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/package-prompt-template.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@dz23-studio/identity": "workspace:*",
    "@dz23-studio/policy": "workspace:*",
    "@dz23-studio/runtime-governor": "workspace:*",
    "@dz23-studio/route-health": "workspace:*",
    "@dz23-studio/tenancy": "workspace:*",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
