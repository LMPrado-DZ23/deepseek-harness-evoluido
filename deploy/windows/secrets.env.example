# DOCUMENTAÇÃO SOMENTE — ESTE ARQUIVO É INTENCIONALMENTE INVÁLIDO.
# Não copie, não renomeie e não use estes marcadores como configuração.
# Execute New-Dz23Secrets.ps1 para gerar os segredos dentro do ext4 do WSL2.
# Nesta fatia, SMTP aceita somente TLS implícito (normalmente porta 465).

DZ23_ACCESS_PROFILE=<local|tailscale|public>
DZ23_EDGE_SECRET=<GERADO_DENTRO_DO_WSL2>
DZ23_PUBLIC_HOST=<HOST_VALIDADO_SEM_PROTOCOLO>
DZ23_PUBLIC_ORIGIN=<ORIGEM_COERENTE_COM_O_PERFIL>
DZ23_RP_ID=<RP_ID_COERENTE_COM_A_ORIGEM>
DZ23_BOOTSTRAP_OWNER_EMAIL=<EMAIL_REAL_DA_PESSOA_PROPRIETARIA>
DZ23_SMTP_SECRET=<JSON_REAL_GUARDADO_COM_PERMISSAO_0600>
DZ23_POSTGRES_PASSWORD=<GERADO_DENTRO_DO_WSL2>
DZ23_POSTGRES_DSN=<GERADO_DENTRO_DO_WSL2>
DZ23_SITE_ADDRESS=<OBRIGATORIO_EM_TAILSCALE_OU_PUBLIC>
DZ23_ACME_EMAIL=<OBRIGATORIO_EM_TAILSCALE_OU_PUBLIC>
DZ23_HTTP_PORT=<8080_LOCAL_OU_80_EXTERNO>
DZ23_HTTPS_PORT=<8443_LOCAL_NAO_PUBLICO_OU_443_EXTERNO>
DZ23_POSTGRES_BACKUP_INTERVAL_MINUTES=<PADRAO_60>
DZ23_POSTGRES_BACKUP_KEEP=<PADRAO_48>
