{
  "name": "dz23-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "plugins/*",
    "apps/*",
    "dsh-home/profiles/studio",
    "third_party/deepseek-harness",
    "third_party/deepseek-harness/apps/*",
    "third_party/deepseek-harness/vendor/*",
    "third_party/deepseek-harness/packages/*/*",
    "third_party/deepseek-harness/native/landlock-run",
    "third_party/deepseek-harness/native/landlock-run/packages/*"
  ],
  "scripts": {
    "studio": "node scripts/studio-start.mjs",
    "studio:doctor": "node scripts/studio-start.mjs --conferir",
    "build:edge": "docker build -f deploy/caddy/Dockerfile -t dz23-studio-caddy:p29c .",
    "build:studio-image": "node scripts/build-studio-image.mjs",
    "gate:domain-scopes": "tsx scripts/check-domain-scopes.ts",
    "gate:domain-routes": "tsx scripts/check-domain-routes.ts",
    "gate:assistant-tools": "tsx scripts/check-assistant-tool-catalog.ts",
    "gate:team-role-tools": "tsx scripts/check-team-role-tools.ts --self-test",
    "gate:rls-coverage": "tsx scripts/check-rls-coverage.ts --self-test",
    "prove:assistant-package": "pnpm --filter @dz23-studio/agents build && pnpm --filter @dz23-studio/agent-team build && pnpm --filter @dz23-studio/assistant-bridge build && node scripts/prove-assistant-package.mjs",
    "prove:assistant-session": "node scripts/prove-assistant-session-runtime.mjs",
    "storage:export-sqlite": "tsx scripts/export-sqlite-storage.ts",
    "storage:export-json": "tsx scripts/export-json-storage.ts",
    "storage:import-postgres": "tsx scripts/import-postgres-storage.ts",
    "storage:backup-postgres": "tsx scripts/backup-postgres-storage.ts",
    "storage:operator-stopped": "node scripts/run-storage-operator.mjs",
    "studio:setup-templates": "node scripts/setup-templates.mjs",
    "prove:edge": "node scripts/prove-edge.mjs",
    "prove:loopback": "node scripts/prove-loopback-binding.mjs --self-test",
    "prove:fase3-agents": "node scripts/prove-fase3-agents.mjs",
    "prove:agent-restart": "node scripts/prove-agent-restart-runtime.mjs",
    "preflight:fase3": "node scripts/preflight-fase3.mjs",
    "prove:postgres-runtime": "node scripts/prove-postgres-runtime.mjs",
    "prove:postgres-soak": "node scripts/prove-postgres-soak.mjs",
    "prove:storage-migration": "node scripts/prove-storage-migration.mjs",
    "prove:runtime": "node scripts/prove-runtime.mjs",
    "prove:studio-runtime": "node scripts/prove-studio-runtime.mjs",
    "prove:builder-isolation": "tsx scripts/prove-builder-isolation.mjs",
    "prove:container-hardening": "tsx scripts/prove-container-hardening.mjs --self-test",
    "prove:template-pipeline": "tsx scripts/prove-template-pipeline.ts",
    "prove:generated-data": "tsx scripts/prove-generated-data.ts",
    "prove:design-spec": "tsx scripts/prove-design-spec.ts",
    "prove:form-database": "tsx scripts/prove-form-database.ts",
    "prove:auth-crud": "tsx scripts/prove-generated-auth-crud.ts",
    "prove:preview-runtime": "tsx scripts/prove-preview-runtime.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:postgres-discovery": "node --test scripts/postgres-specs-lib.test.mjs",
    "test:postgres:coverage": "node scripts/test-postgres.mjs --coverage",
    "test:postgres:runtime": "node scripts/test-postgres.mjs --runtime",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:w3:coverage": "vitest run --config vitest.w3.config.ts --coverage",
    "build": "pnpm --recursive --filter \"@dz23-studio/*\" --filter \"@studio/*\" --if-present run build",
    "gate:upstream-pin": "node scripts/check-upstream-pin.mjs --self-test",
    "gate:portability": "node scripts/check-portability.mjs --self-test",
    "gate:i18n": "node scripts/check-i18n.mjs",
    "gate:vocabulary": "node scripts/check-vocabulary.mjs --self-test && node scripts/check-vocabulary.mjs",
    "gate:memory-map": "node scripts/check-memory-map.mjs --self-test && node scripts/check-memory-map.mjs",
    "gate:constitution": "node scripts/check-constitution.mjs --self-test && node scripts/check-constitution.mjs",
    "golden": "tsx scripts/run-golden-set.ts",
    "gate:comprehension": "tsx scripts/golden-set-comprehension.mjs --self-test && tsx scripts/golden-set-comprehension.mjs",
    "prove:prompt-to-app": "tsx scripts/prove-prompt-to-app.ts",
    "prove:integration-hub": "node scripts/prove-integration-hub.mjs",
    "hub:sign": "node scripts/hub-sign-manifest.mjs",
    "prove:backup-restore": "node scripts/prove-backup-restore.mjs",
    "i18n:baseline": "node scripts/build-i18n-baseline.mjs",
    "gate:tracked-lib": "node scripts/check-tracked-lib.mjs --self-test && node scripts/check-tracked-lib.mjs",
    "gate:typecheck": "node scripts/check-typecheck.mjs",
    "gate:profile-mounts": "node scripts/check-profile-mounts.mjs --self-test && node scripts/check-profile-mounts.mjs",
    "gate:lib-freshness": "node scripts/check-lib-freshness.mjs --self-test && node scripts/check-lib-freshness.mjs",
    "gate:image-lock": "node scripts/check-image-lock.mjs",
    "gate:decision-record": "node scripts/check-decision-record.mjs --self-test && node scripts/check-decision-record.mjs",
    "gate:requirements-ledger": "node scripts/check-requirements-ledger.mjs --self-test && node scripts/check-requirements-ledger.mjs",
    "gate:secrets": "node scripts/check-secrets.mjs --self-test && node scripts/check-secrets.mjs",
    "gate:no-caveman": "node scripts/check-no-caveman.mjs --self-test && node scripts/check-no-caveman.mjs",
    "gate:p37": "node scripts/check-p37-inventory.mjs --self-test && node scripts/check-p37-inventory.mjs",
    "gate:candidates": "node scripts/check-candidates.mjs --self-test && node scripts/check-candidates.mjs",
    "gate:vendored-references": "node scripts/check-vendored-references.mjs --self-test && node scripts/check-vendored-references.mjs",
    "gate:licenses": "node scripts/check-release-licenses.mjs --self-test && node scripts/check-release-licenses.mjs",
    "gate:licenses:release": "node scripts/check-release-licenses.mjs --release",
    "sbom:cyclonedx": "pnpm sbom --sbom-format cyclonedx --lockfile-only > sbom.cdx.json"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-storage-sqlite": "workspace:*",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "license": "Apache-2.0"
}
