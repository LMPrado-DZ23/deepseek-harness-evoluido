{
  "name": "dz23-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "prove:runtime": "node scripts/prove-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm --recursive run build"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
