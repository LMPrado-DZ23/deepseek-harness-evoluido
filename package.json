{
  "name": "dz23-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build:edge": "docker build -f deploy/caddy/Dockerfile -t dz23-studio-caddy:p29c .",
    "gate:domain-scopes": "tsx scripts/check-domain-scopes.ts",
    "storage:export-sqlite": "tsx scripts/export-sqlite-storage.ts",
    "storage:import-postgres": "tsx scripts/import-postgres-storage.ts",
    "prove:edge": "node scripts/prove-edge.mjs",
    "prove:fase3-agents": "node scripts/prove-fase3-agents.mjs",
    "preflight:fase3": "node scripts/preflight-fase3.mjs",
    "prove:postgres-runtime": "node scripts/prove-postgres-runtime.mjs",
    "prove:runtime": "node scripts/prove-runtime.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:postgres:coverage": "node scripts/test-postgres.mjs --coverage",
    "test:postgres:runtime": "node scripts/test-postgres.mjs --runtime",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm --recursive run build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage": "link:/home/leandro/harness-studio-poc02/deepseek-harness/packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:/home/leandro/harness-studio-poc02/deepseek-harness/packages/storage/storage-domain",
    "@deepseek-ai/dsh-storage-sqlite": "link:/home/leandro/harness-studio-poc02/deepseek-harness/packages/storage/storage-sqlite",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
